    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
